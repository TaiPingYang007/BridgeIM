MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=chatserver
MYSQL_USER=chatserver_app
MYSQL_PASSWORD=chatserver_dev_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

ZK_ENDPOINTS=127.0.0.1:2181

# RPC Provider (OfflineMessageService)
RPC_PORT=7000

# mprpc logging: "stdout" or "file"
MPRPC_LOG_MODE=file
# mprpc log directory (when MPRPC_LOG_MODE=file)
MPRPC_LOG_DIR=bin
